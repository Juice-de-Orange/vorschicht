# =============================================================================
# Vorschicht — environment template
# Copy to `.env` (chmod 600) and fill in. `.env` is git-ignored and must NEVER
# be committed. gitleaks runs as a baseline gate from Phase 0 (§11, §19).
# Every value below is a placeholder; nothing here points at a real host.
# =============================================================================

# --- paths (A2/A33) ----------------------------------------------------------
# Projects root on the host: each onboarded project lives at <root>/<slug>.
# The orchestrator gets this directory bind-mounted READ-WRITE at /projects, so
# it has to be a directory that holds project checkouts and nothing else —
# never a shared one such as /opt, /srv or a home directory.
# Left unset, the base compose file uses infra/.vorschicht-data/projects inside
# this checkout (git-ignored). The production overlay
# (infra/docker-compose.override.example.yml) falls back to /opt instead, so on
# a real host set it explicitly.
#VORSCHICHT_PROJECTS_ROOT=/srv/vorschicht-projects
# Vorschicht's own data volumes: postgres, docs, transcripts, backups, claude.
VORSCHICHT_DATA_ROOT=/srv/vorschicht
# Task worktrees (§10). Defaults to <VORSCHICHT_DATA_ROOT>/worktrees. Kept out
# of the projects root so a worktree never looks like a project; disposable,
# because the commits live in the project repository, not here.
#VORSCHICHT_WORKTREES_ROOT=/srv/vorschicht/worktrees
# Archived session transcripts (§6.2, §18). Defaults to
# <VORSCHICHT_DATA_ROOT>/transcripts. Unlike the worktrees this one *is* in the
# backup (A14): principle 4's traceability chain ends at a transcript line.
#VORSCHICHT_TRANSCRIPTS_ROOT=/srv/vorschicht/transcripts
# §13's document vault — where uploaded files are stored. Defaults to
# <VORSCHICHT_DATA_ROOT>/docs, and it is in the backup (A14) because a
# `document_versions` row is a pointer and these bytes are the document. Inside
# compose the app, the orchestrator and the backup sidecar all mount the same
# volume at /data/docs; if you override this, override it for all three or the
# vault's readers will not find what the upload route wrote.
#VORSCHICHT_DOCS_ROOT=/srv/vorschicht/docs

# --- database ----------------------------------------------------------------
POSTGRES_USER=vorschicht
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vorschicht
# For processes started *outside* compose only (`pnpm db:migrate`, `pnpm
# onboard`, an app or daemon run from the checkout) — and only when exported
# into their environment. The compose stack does not read it: every service
# gets its own URL with the service name `db`, and the base compose file
# publishes no database port (§3). 5436 stands for a port you publish or tunnel
# yourself.
DATABASE_URL=postgres://vorschicht:change-me@127.0.0.1:5436/vorschicht
# NOT WIRED (A94) — read by nothing. The `vorschicht_app` role exists (0001
# creates it, every migration since grants to it), but its name is hard-coded,
# no entrypoint sets its password, and compose points both services at
# POSTGRES_USER — the owner. So setting these buys nothing today, and the
# GRANT/REVOKE layer protects a role nobody connects as. Kept and labelled
# rather than deleted: whoever fills them in has good reason to believe in a
# protection that does not engage. The append-only guarantee is unaffected — it
# rests on triggers that bind every role including the owner (§18).
APP_DB_ROLE=vorschicht_app
APP_DB_PASSWORD=change-me-too

# --- app / ingress (A1) ------------------------------------------------------
APP_BIND=127.0.0.1
APP_PORT=8420
# The public origin your reverse proxy serves the dashboard on. For a local
# trial `http://localhost:8420` works (WebAuthn accepts `localhost` as RP id).
PUBLIC_ORIGIN=https://vorschicht.example.com
# WebAuthn relying-party id == the public hostname, no scheme, no port (§19).
WEBAUTHN_RP_ID=vorschicht.example.com
WEBAUTHN_RP_NAME=Vorschicht
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-openssl-rand-base64-48

# --- Claude Code access (§6.1, A5, A27) --------------------------------------
# From `claude setup-token` on a trusted machine. Subscription auth only —
# an API key is forbidden by §2 and asserted against at startup.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# Exact pinned CLI version. Updates only via radar task through the gates (A27).
CLAUDE_CLI_VERSION=2.1.220
# Per-role settings files carrying the §6.6 containment hooks (`--settings`).
# Baked into the orchestrator image; override only to point at a fixture set.
#VORSCHICHT_ROLE_SETTINGS_DIR=/app/claude
# Entry point of the internal vorschicht MCP server (§6.2, §13). The
# `--mcp-config` document is written per run — it carries the task id, which is
# what binds a session to exactly one task — so this names the server, not the
# document. Unset means sessions spawn without MCP: a role that cannot look up
# its task, rather than a run that dies at startup.
#VORSCHICHT_MCP_SERVER=/app/packages/mcp/dist/main.js
# The §6.6 containment hook the CLI spawns before every tool call. The daemon
# writes the role settings above from this path at start-up and refuses to take
# work if it cannot; baked into the image, override only for a test build.
#VORSCHICHT_HOOK_ENTRY=/app/node_modules/@vorschicht/core/dist/hook-entry.js
# Scratch directory for per-run files: the MCP config above and the run's
# containment policy. Deliberately not a volume — everything in it belongs to a
# run in flight, and a restart ends every run it could belong to.
#VORSCHICHT_RUNS_ROOT=/data/runs

# Where the backup sidecar leaves its per-component result document (§18, A14).
# The daemon reads it once per pass and turns it into `backup.succeeded` /
# `backup.failed` plus one ntfy alert per outage. Must match the path the
# backups volume is mounted at in `infra/docker-compose.yml`; the sidecar
# itself writes to `/backups` unconditionally.
#VORSCHICHT_BACKUP_RESULT=/backups/.last-result

# --- radar (§6.0, A27, A10) ---------------------------------------------------
# The two Anthropic channels have NO default, deliberately. Left unset, the
# radar reports them on every run as surfaces it did not check — which is not
# the same as reporting them clean, and is the whole point: §6.0 calls a change
# to the billing of programmatic use this project's #1 external risk, and a
# guessed URL that 404s every six hours would read as "nothing announced".
#
# Billing watch: comma-separated pages to read. The detector needs a term for
# programmatic use and a term for a billing change in the SAME sentence before
# it raises anything, so a documentation page costs nothing. A hit is a P0 inbox
# item.
#VORSCHICHT_RADAR_BILLING_URLS=https://example.test/pricing,https://example.test/changelog
# CLI release channel (A27). Anything whose text carries a version: a JSON
# document with `latest` / `version` / `tag_name`, or a changelog. A version
# ahead of CLAUDE_CLI_VERSION becomes an ordinary radar task through the normal
# gates — never an automatic bump.
#VORSCHICHT_RADAR_CLI_URL=https://example.test/claude-code/latest
# Where the dependency and advisory radar asks (A10). This one IS defaulted,
# because the shape of `registry.npmjs.org` is nameable; override for a mirror.
#VORSCHICHT_RADAR_REGISTRY=https://registry.npmjs.org

# --- notifications (§16) -----------------------------------------------------
# A self-hosted or hosted ntfy server; topics are token-protected (§19).
NTFY_SERVER=https://ntfy.example.com
NTFY_TOKEN=tk_...
NTFY_TOPIC_INBOX=vorschicht-inbox
NTFY_TOPIC_ALERTS=vorschicht-alerts
NTFY_TOPIC_INFO=vorschicht-info

# --- e-mail (§16, wired in Phase 4) ------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vorschicht <vorschicht-bot@example.com>
REPORT_RECIPIENT=

# --- git identity for agent commits (A20/A36/A39) ----------------------------
# Every commit the studio makes is authored as the bot, never as a person. The
# gate and orchestrator images bake the same identity (infra/docker/*).
GIT_AUTHOR_NAME=Vorschicht Bot
GIT_AUTHOR_EMAIL=vorschicht-bot@example.com

# --- operations --------------------------------------------------------------
TZ=Europe/Vienna
# Concurrency follows the subscription plan profile: max_20x -> 2, max_5x -> 1 (A7).
PLAN_PROFILE=max_20x
LOG_LEVEL=info
