{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "needs_decision",
        "failed",
        "parked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "followups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "changes_requested"
      ]
    },
    "citations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "claimedLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "claimedLevel",
          "statement"
        ]
      }
    },
    "documents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "severity": {
            "type": "string",
            "const": "blocker"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "severity",
          "summary"
        ]
      }
    }
  },
  "required": [
    "status",
    "summary",
    "verdict"
  ]
}
