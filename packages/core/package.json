{
  "name": "@vorschicht/core",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent-entry.d.ts",
      "default": "./dist/agent-entry.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vorschicht/db": "workspace:*",
    "@vorschicht/shared": "workspace:*",
    "pg-boss": "^11.0.4",
    "postgres": "^3.4.9",
    "zod": "^4.1.13"
  }
}
