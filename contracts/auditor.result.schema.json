{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "needs_decision",
        "failed",
        "parked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "followups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "gate_truth",
        "claim_vs_evidence",
        "test_substance",
        "assumption_revision",
        "containment_boundaries",
        "dead_wiring",
        "process_compliance",
        "number_reconciliation"
      ]
    },
    "sample": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "gate_invalid",
              "defect",
              "process",
              "coverage_gap",
              "assumption_expired",
              "suspicion"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string"
          },
          "guard": {
            "type": "string"
          },
          "reopens": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "class",
          "summary",
          "evidence"
        ]
      }
    },
    "scopeLimits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "unbedenklich",
        "funde_zu_beheben",
        "phase_nicht_abschliessbar"
      ]
    }
  },
  "required": [
    "status",
    "summary",
    "domain",
    "sample",
    "scopeLimits",
    "verdict"
  ]
}
